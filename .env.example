# Copy this file to .env in the repository root. Never commit .env.
# Restart the API and Vite after changing configuration.
# Explicit arguments/CLI options override process environment, then .env defaults.

# Console/file logging; disabled by default.
ENABLE_LOG=false

# Persistent dataset originals, Parquet partitions, SQLite, jobs, and exports.
# Relative paths resolve from the process working directory.
MULTIGAS_APP_DIR=output/app

# Maximum CSV/TOA5 upload size in bytes (5 GiB).
MULTIGAS_UPLOAD_LIMIT_BYTES=5368709120

# DuckDB buffer budget, not a limit on total Python/browser/plot memory.
MULTIGAS_DUCKDB_MEMORY_LIMIT=512MB

# Optional absolute path to frontend/dist for FastAPI production hosting.
# Leave empty when using the Vite development server.
MULTIGAS_STATIC_DIR=

# Server-side Vite API proxy; API still starts on the port supplied to Uvicorn.
# This value is not exposed as a browser-side VITE_* variable.
MULTIGAS_API_TARGET=http://127.0.0.1:8001

# main.py two-second example source; CLI --source overrides this value.
MULTIGAS_EXAMPLE_SOURCE='D:\Data\Multigas Tangkuban Parahu\TANG_RTU\TANG_RTU_ChemData_Sec2.dat'
